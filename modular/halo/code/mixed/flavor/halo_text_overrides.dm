// HALO late localized flavor overrides for upstream ports #114 and #118.

/obj/item/clothing/suit/marine/unsc
	name = "\improper бронежилет M52B"
	desc = "Штатная броня корпуса морской пехоты ККОН. Комплект M52B принят на вооружение к 2531 году для войны с Ковенантом. Обновлённый состав сплава Titanium-A заметно усилил защиту от направленной энергии, хотя и не настолько, как рассчитывали."

/obj/item/clothing/accessory/pads/unsc
	name = "\improper наплечники M52B"
	desc = "Пара наплечников из сплава Ti-A, крепящихся к бронекомплекту M52B корпуса морской пехоты ККОН и защищающих плечи с верхней частью рук."

/obj/item/clothing/accessory/pads/unsc/bracers
	name = "\improper наручи M52B"
	desc = "Пара композитных наручей, крепящихся к бронекомплекту M52B корпуса морской пехоты ККОН для защиты предплечий."

/obj/item/clothing/accessory/pads/unsc/bracers/police
	name = "\improper полицейские наручи"
	desc = "Дополнительная защита для баллистических жилетов, часто встречающаяся у полиции. Уверенно держит маломощные боеприпасы и тупые удары."

/obj/item/clothing/accessory/pads/unsc/neckguard
	name = "\improper горловая защита M52B"
	desc = "Дополнительная горловая защита для бронекомплекта M52B корпуса морской пехоты ККОН. Рассчитана на осколки и часть маломощных попаданий."

/obj/item/clothing/accessory/pads/unsc/neckguard/police
	name = "\improper полицейская горловая защита"
	desc = "Дополнительная защита для баллистических жилетов. В полицейской службе её используют как дешёвое усиление для подавления беспорядков и ситуаций повышенной угрозы."

/obj/item/clothing/accessory/pads/unsc/greaves
	name = "\improper поножи M52B"
	desc = "Пара композитных поножей для бронекомплекта M52B корпуса морской пехоты ККОН. Предназначены для совместной работы с защитой ботинок VZG7 и прикрывают от осколков, сколов и порезов."

/obj/item/clothing/accessory/pads/unsc/groin
	name = "\improper напашник M52B"
	desc = "Дополнительная защита живота и паха для бронекомплекта M52B корпуса морской пехоты ККОН. Включение Titanium-A даёт неожиданно высокую стойкость к огнестрелу и касательным энергетическим попаданиям."

/obj/item/clothing/accessory/pads/unsc/groin/police
	name = "\improper полицейский напашник"
	desc = "Дополнительная защита для баллистических жилетов, прикрывающая нижнюю часть живота и пах. Помогает спасти жизненно важные органы и артерии от маломощного оружия и рикошетов, потому чаще всего встречается у полиции."

/obj/item/clothing/accessory/pads/unsc/odst
	name = "\improper наплечники M70DT"
	desc = "Пара наплечников из Ti-A для штатного бронекомплекта M70DT десантников ОДСБ. Обеспечивает защиту плеч и часто несёт медицинскую маркировку."

/obj/item/clothing/accessory/pads/unsc/bracers/odst
	name = "\improper наручи M70DT"
	desc = "Пара наручей из Ti-A для штатного бронекомплекта M70DT десантников ОДСБ."

/obj/item/clothing/accessory/pads/unsc/greaves/odst
	name = "\improper поножи M70DT"
	desc = "Пара поножей из Ti-A для штатного бронекомплекта M70DT десантников ОДСБ. По требованиям снабжения комплект M70DT не использует схему VZG7 ради большей гибкости снаряжения, поэтому эти поножи полноразмерные."

/obj/item/clothing/accessory/pads/unsc/groin/odst
	name = "\improper напашник M70DT"
	desc = "Защита живота и паха для штатного бронекомплекта M70DT десантников ОДСБ. Пластины из Titanium-A заметно повышают уровень защиты."

/obj/item/clothing/accessory/storage/webbing/m52b
	name = "\improper разгрузка образца M52B"
	desc = "Универсальная конфигурация для переноски снаряжения. Состоит из жаростойких синтетических тканей и крепится прямо к жёстким точкам брони M52B системой пряжек."

/obj/item/clothing/accessory/storage/webbing/m52b/mag
	name = "\improper магазинная разгрузка образца M52B"
	desc = "Вариант стандартной разгрузки под оружейные магазины. Сшита из жаростойкой синтетики, крепится прямо к броне M52B системой пряжек и выполнена по пятиячеечной схеме."

/obj/item/clothing/accessory/storage/webbing/m52b/shotgun
	name = "\improper разгрузка под дробовые патроны образца M52B"
	desc = "Конфигурация стандартной разгрузки под дробовые патроны. Сшита из жаростойкой синтетики, крепится прямо к броне M52B системой пряжек и всё чаще встречается у бойцов ближнего боя и сил безопасности в новой войне."

/obj/item/clothing/accessory/storage/webbing/m52b/small
	name = "\improper утилитарная разгрузка образца M52B"
	desc = "Утилитарная конфигурация с удобными подсумками под разную мелочь. Сшита из жаростойкой синтетики и крепится прямо к жёстким точкам брони M52B системой пряжек."

/obj/item/clothing/accessory/storage/webbing/m52b/grenade
	name = "\improper гранатный подсумок образца M52B"
	desc = "Разгрузочная конфигурация для гренадёров под штатные 40-мм гранаты. При необходимости удержит и пистолеты M9 для более олдскульных бойцов. Сделана из жаростойкой синтетики, крепкая и проверенная временем."

/obj/item/weapon/gun/rifle/halo/ma5c
	name = "штурмовая винтовка MA5C ICWS"
	desc = "Буллпап под 7.62x51 мм с целым набором улучшений по сравнению с вариантом B. Уменьшенный шаг нарезов 1:7 и переработанные контактные поверхности повышают точность и устойчивость в автоматическом огне, а новый 48-зарядный магазин отличается высокой надёжностью."

/obj/item/weapon/gun/rifle/halo/ma5b
	name = "штурмовая винтовка MA5B ICWS"
	desc = "Старый вариант выдаёт бешеные 900 выстрелов в минуту и питается от магазина на 60 патронов. Ветераны и подразделения, ожидающие ближний бой, по возможности всё ещё выбирают именно B-вариант, хотя именно его недостатки и привели к появлению преемника."
	desc_lore = "На бумаге MA5B любили все, но в автоматическом огне она дико неустойчива, а в полуавтомате уступает по кучности. Даже самые прожжённые ветераны признают, что MA5C в полном авто будто прилипает к стрелку по сравнению с B-вариантом. И это ещё без главной беды: магазины капризны, требуют ухода и без него постоянно дают задержки. В отчаянных боях ранней войны с Ковенантом на такую аккуратность просто не оставалось времени."

/obj/item/weapon/gun/rifle/halo/ma3a
	name = "штурмовая винтовка MA3A"
	desc = "Предшественник серии MA5 прослужил недолго, уступив место более продуманной линейке, но крупный выпуск обеспечил ему долгую вторую жизнь у частной охраны и повстанцев."
	desc_lore = "В отличие от серии MA5, MA3A обычно оснащалась перегруженной режимами обычной компьютерной оптикой, склонной к поломкам. Когда она работала, результат был отличным, но постоянные перенастройки и плохая автономность доводили солдат до белого каления, поэтому строевые части ККОН быстро от неё отказались."

/obj/item/weapon/gun/rifle/halo/vk78
	name = "винтовка VK78 со складов"
	desc = "Винтовка под 6.5x48 мм, когда-то заменившая устаревающую HMG-38 у Колониальной военной администрации. Надёжная автоматика и привычная компоновка пережили саму КВА, после чего оружие разошлось по милиции, преступникам и порой даже колонистам. Услышали этот характерный лай на патруле, скорее всего это не друзья."

/obj/item/weapon/gun/rifle/halo/br55
	name = "боевая винтовка BR55"
	desc = "Новая винтовка меткой стрельбы корпуса морской пехоты ККОН. Заметно мощнее MA5, а необычная схема нарезов даёт отличную точность и кучность на любой дистанции. Стандартный магазин рассчитан на 36 патронов 9.5x40 мм HP-SAP-HE с новым порохом и очень высоким давлением в патроннике для существенного прироста начальной скорости."

/obj/item/weapon/gun/smg/halo/m7
	name = "пистолет-пулемёт M7"
	desc = "Компактный пистолет-пулемёт под безгильзовый патрон 5 мм. Складной приклад, складывающаяся рукоять и приличная останавливающая способность сделали M7 своим в абордаже, охране и спецоперациях."

/obj/item/weapon/gun/smg/halo/m7/socom
	name = "пистолет-пулемёт M7S"

/obj/item/weapon/gun/shotgun/pump/halo/m90
	name = "\improper дробовик M90 CAWS"
	desc = "Помповый дробовик производства Weapon System Technology, состоящий на вооружении сил ККОН для ближнего боя. Питается двенадцатью 8-калиберными патронами из внутреннего трубчатого магазина с фирменной верхней зарядкой."

/obj/item/weapon/gun/rifle/sniper/halo
	name = "снайперская винтовка SRS99-AM"
	desc = "Новая штатная снайперская винтовка ККОН. Использует магазин на 4 патрона 14.5x114 мм APFSDS и показывает выдающиеся результаты на предельных дистанциях. Её характерная особенность - заметная модульность, особенно в районе ствола, который можно быстро заменить целиком."

/obj/item/weapon/gun/pistol/halo/m6c
	name = "служебный магнум M6C"
	desc = "Полуавтоматический пистолет под 12.7x40 мм с коротким ходом ствола. Подача и рукоять здесь переработаны в попытке исправить поломки и проблемы надёжности. Его укороченный профиль удобен в тесноте, но неполное сгорание пороха заметно режет ожидаемые характеристики."

/obj/item/weapon/gun/pistol/halo/m6c/m4a
	name = "пистолет M4A"
	desc = "Винтажный пистолет под 12.7x40 мм, популярный у гражданских и преступников. Предшественник более известной серии M6 был официально заменён ещё в 2414 году. Жалобы на него всегда были одни и те же: слабая точность, ослепляющая грязная вспышка и оглушительный выстрел. Именно это и подарило ему вторую жизнь у новой публики."

/obj/item/weapon/gun/pistol/halo/m6g
	name = "служебный магнум M6G"
	desc = "За счёт более длинного ствола и полигональных нарезов M6G точнее и быстрее своих предшественников. Вместимость при этом сократили до 8 патронов ради уменьшения оружия и боезапаса, но ценой потери обратной совместимости."

/obj/item/weapon/gun/pistol/halo/m6d
	name = "служебный магнум M6D"
	desc = "Вариант D заслужил репутацию мощного и точного пистолета. Для части стрелков встроенный малократный смарт-прицел KFA-2 делает его в плотной городской застройке чуть ли не заменой снайперской винтовке. Но у блеска есть цена: многие считают, что добавленный объём делает оружие слишком неповоротливым."
	desc_lore = null

/obj/item/weapon/gun/pistol/halo/m6a
	name = "служебный магнум M6A"
	desc = "Снятый с производства представитель семейства M6. Только вариант A получил узел поглощения отдачи, но проблемы с потерей скорости и точности так и остались до самой замены. Теперь его чаще можно встретить у охраны и правоохранителей как более компактное и удобное оружие постоянного ношения."

/obj/item/explosive/grenade/high_explosive/m15/unsc
	name = "осколочная граната M9"
	desc = "Штатная осколочная граната ККОН. 190 граммов состава L надёжно засыпают осколками радиус до 15 метров."

/obj/item/ammo_magazine/rifle/halo/ma5c
	name = "\improper магазин MA5C (7.62x51 мм FMJ)"
	desc = "Магазин для MA5C на 48 патронов 7.62x51 мм FMJ. Боеприпас M118 FMJ даёт надёжную работу, ограниченную пробиваемость укрытий и умеренный бронепробой."

/obj/item/ammo_magazine/rifle/halo/ma5c/shredder
	name = "\improper магазин MA5C (7.62x51 мм Shredder)"
	desc = "Магазин для MA5C на 48 патронов 7.62x51 мм Shredder - специализированных боеприпасов, пробивающих броню и дающих тяжёлый заброневой эффект."

/obj/item/ammo_magazine/rifle/halo/ma5b
	name = "\improper магазин MA5B (7.62x51 мм FMJ)"
	desc = "Магазин для MA5B на 60 патронов 7.62x51 мм FMJ. Самые частые точки отказа здесь - губки и пружина подачи, так что обращайтесь с ним бережно."

/obj/item/ammo_magazine/rifle/halo/ma5b/shredder
	name = "\improper магазин MA5B (7.62x51 мм Shredder)"
	desc = "Магазин для MA5B на 60 патронов 7.62x51 мм Shredder - специализированных боеприпасов, пробивающих броню и наносящих тяжёлый заброневой урон. Губки и пружина подачи здесь особенно капризны, так что уход обязателен."

/obj/item/ammo_magazine/rifle/halo/ma3a
	name = "\improper магазин MA3A (7.62x51 мм FMJ)"
	desc = "Магазин для MA3A на 32 патрона 7.62x51 мм FMJ."

/obj/item/ammo_magazine/rifle/halo/vk78
	name = "\improper магазин VK78 (6.5x48 мм FMJ)"
	desc = "Угловатый магазин для VK78 на 20 патронов 6.5x48 мм FMJ."

/obj/item/ammo_magazine/rifle/halo/br55
	name = "\improper магазин BR55 (9.5x40 мм X-HP SAP-HE)"
	desc = "Магазин для BR55 на 36 патронов 9.5x40 мм X-HP SAP-HE."

/obj/item/ammo_magazine/rifle/halo/br55/extended
	name = "\improper четырёхрядный магазин BR55 (9.5x40 мм X-HP SAP-HE)"
	desc = "Четырёхрядный магазин для BR55 на 60 патронов 9.5x40 мм X-HP SAP-HE."

/obj/item/ammo_magazine/rifle/halo/dmr
	name = "\improper магазин M392 DMR (7.62x51 мм FMJ)"
	desc = "Прямоугольный магазин на 15 патронов 7.62x51 мм FMJ для M392 DMR."

/obj/item/ammo_magazine/rifle/halo/sniper
	name = "\improper магазин SRS99-AM (14.5x114 мм APFSDS)"
	desc = "Магазин для SRS99-AM на четыре патрона 14.5x114 мм APFSDS."

/obj/item/ammo_magazine/spnkr
	name = "\improper тубус M19 SSM"
	desc = "Двухтрубный ракетный блок калибра 102 мм, предназначенный для загрузки в M41 SPNKR."

/obj/item/ammo_magazine/pistol/halo/m6c
	name = "\improper магазин M6C (12.7x40 мм SAP-HE)"
	desc = "Наклонный прямоугольный магазин для M6C на 12 патронов 12.7x40 мм SAP-HE."

/obj/item/ammo_magazine/pistol/halo/m6a
	name = "\improper магазин M6A (12.7x40 мм SAP-HE)"
	desc = "Наклонный прямоугольный магазин для M6A на 12 патронов 12.7x40 мм SAP-HE."

/obj/item/ammo_magazine/pistol/halo/m6g
	name = "\improper магазин M6G (12.7x40 мм SAP-HE)"
	desc = "Наклонный прямоугольный магазин для M6G на 8 патронов 12.7x40 мм SAP-HE."

/obj/item/ammo_magazine/pistol/halo/m6d
	name = "\improper магазин M6D (12.7x40 мм SAP-HE)"
	desc = "Наклонный прямоугольный магазин для M6D на 12 патронов 12.7x40 мм SAP-HE. Хромированная отделка."

/obj/structure/machinery/computer/med_data/laptop
	desc = "Ноутбук, подключённый к базе медицинских записей."

/obj/structure/machinery/faxmachine/uscm
	name = "факс-аппарат ККОН"

/obj/item/newspaper
	desc = "Газета, в которой почти нет ничего интересного. Может, именно это подразделение станет следующей историей, но счастливой она будет только в ваших руках."

/obj/structure/machinery/cm_vending/sorted/medical/blood
	name = "блок хранения крови"
	desc = "Охлаждаемая система хранения пакетов крови со встроенным учётом, помогающим следить за сроком годности."

/obj/item/prop/helmetgarb/gunoil
	name = "оружейная смазка"
	desc = "Флакон специализированного масла. С темпом стрельбы серии MA5 и количеством пуль, нужных для уверенного поражения цели, морпехи расходуют это почти как магазины."

/obj/item/prop/helmetgarb/netting
	name = "сетчатый чехол на шлем"
	desc = "Сетка, которую можно закрепить на шлеме для маскировки или переноски мелочей."

/obj/item/prop/helmetgarb/raincover
	desc = "Водонепроницаемая накидка, отводящая дождь от головы и позволяющая владельцу промокнуть чуть меньше."

/obj/item/prop/helmetgarb/camocover
	desc = "Эластичный чехол на шлем, помогающий подогнать его под палитру местности."

/obj/item/prop/helmetgarb/lucky_feather/yellow
	desc = "Ярко-жёлтое перо. Возможно, канарейки. Если бы оно не было поддельным."

/obj/item/prop/helmetgarb/helmet_nvg
	name = "прибор ночного видения"
	desc = "Улучшенная визуальная система для ночных операций."

/obj/item/prop/helmetgarb/helmet_nvg/cosmetic
	name = "выпотрошенный прибор ночного видения"
	desc = "Старая оболочка без начинки. Странный талисман, но и не самый странный."

/obj/item/reagent_container/food/drinks/cans/classcola
	name = "Class Cola"
	desc = "Классическое сочетание красного и белого. Легендарная американская газировка, которую до сих пор разливают на Земле и на нескольких колониях."

/obj/item/reagent_container/food/condiment/hotsauce/tabasco
	name = "бутылка соуса табаско"
	desc = "Табаско родом из США, несмотря на название в честь мексиканского города. Соус щедро приправлен, с заметным уксусом, лёгкой сладостью и дымком."

/obj/item/reagent_container/food/snacks/microwavable/donkpocket
	name = "сэндвич-карман для микроволновки"
	desc = "Простой сэндвич с мясной, сырной и соусной начинкой. Для лучшего результата грейте прямо в упаковке."
	warm_desc = "Разогретый сэндвич с мясом, сыром и соусом. Съедобно, но не более."

/obj/item/clothing/mask/cigarette/cigar
